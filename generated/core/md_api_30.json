{
  "openapi": "3.0.3",
  "info": {
    "title": "Cube Mendelev HTTP API",
    "contact": {
      "name": "Cube",
      "url": "https://www.cube.exchange",
      "email": "support@cube.exchange"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/book/{market_id}/snapshot": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "market_id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "style": "simple"
          },
          {
            "in": "query",
            "name": "mbp",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "mbo",
            "schema": {
              "type": "boolean",
              "default": false
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "levels",
            "schema": {
              "type": "integer",
              "format": "uint",
              "minimum": 0,
              "default": null,
              "nullable": true
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_OrderBookSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "An error was encountered while processing the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_AnyValue",
                  "example": {
                    "error": {
                      "code": "E10000",
                      "reason": "Reason"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/book/{market_id}/recent-trades": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "market_id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_TradesSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "An error was encountered while processing the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_AnyValue",
                  "example": {
                    "error": {
                      "code": "E10000",
                      "reason": "Reason"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/tickers/snapshot": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_TopsSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "An error was encountered while processing the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_AnyValue",
                  "example": {
                    "error": {
                      "code": "E10000",
                      "reason": "Reason"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parsed/tickers": {
      "get": {
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_Array_of_ParsedTickerResponse"
                }
              }
            }
          },
          "500": {
            "description": "An error was encountered while processing the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_AnyValue",
                  "example": {
                    "error": {
                      "code": "E10000",
                      "reason": "Reason"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parsed/book/{market_symbol}/snapshot": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "market_symbol",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "simple"
          },
          {
            "in": "query",
            "name": "depth",
            "schema": {
              "type": "integer",
              "format": "uint",
              "minimum": 0,
              "nullable": true
            },
            "style": "form"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_ParsedOrderBookResponse"
                }
              }
            }
          },
          "500": {
            "description": "An error was encountered while processing the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_AnyValue",
                  "example": {
                    "error": {
                      "code": "E10000",
                      "reason": "Reason"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/parsed/book/{market_symbol}/recent-trades": {
      "get": {
        "parameters": [
          {
            "in": "path",
            "name": "market_symbol",
            "required": true,
            "schema": {
              "type": "string"
            },
            "style": "simple"
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_ParsedTradesSnapshot"
                }
              }
            }
          },
          "500": {
            "description": "An error was encountered while processing the request.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Body_for_AnyValue",
                  "example": {
                    "error": {
                      "code": "E10000",
                      "reason": "Reason"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_for_OrderBookSnapshot": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/OrderBookSnapshot"
          }
        },
        "required": [
          "result"
        ]
      },
      "OrderBookSnapshot": {
        "anyOf": [
          {
            "$ref": "#/components/schemas/MbpOrderBookSnapshot"
          },
          {
            "$ref": "#/components/schemas/MboOrderBookSnapshot"
          }
        ],
        "example": {
          "levels": [
            {
              "price": 647520,
              "quantity": 76600,
              "side": 0
            },
            {
              "price": 647530,
              "quantity": 60100,
              "side": 1
            }
          ],
          "lastTransactTime": 1721102467166459400,
          "lastTradePrice": 646930,
          "marketState": "normalOperation"
        }
      },
      "MbpOrderBookSnapshot": {
        "type": "object",
        "properties": {
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Level"
            }
          },
          "lastTransactTime": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "lastTradePrice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Price"
              },
              {
                "type": "null"
              }
            ]
          },
          "marketState": {
            "$ref": "#/components/schemas/MarketState"
          }
        },
        "required": [
          "levels",
          "lastTransactTime",
          "marketState"
        ]
      },
      "Level": {
        "description": "Each price level is the aggregate total quantity of orders placed at that\n price.",
        "type": "object",
        "properties": {
          "price": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "side": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "price",
          "quantity",
          "side"
        ]
      },
      "Price": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "MarketState": {
        "description": "The per-market matching engine state. Affects order-entry.",
        "oneOf": [
          {
            "description": "Sentinel",
            "type": "string",
            "enum": [
              "unspecified"
            ]
          },
          {
            "description": "The market is in its normal operating state. All order operations are\n supported.",
            "type": "string",
            "enum": [
              "normalOperation"
            ]
          },
          {
            "description": "The market is in cancel-only mode. Existing orders are not automatically\n canceled, and may be filled when the market transitions back to\n normal-operation.",
            "type": "string",
            "enum": [
              "cancelOnly"
            ]
          }
        ]
      },
      "MboOrderBookSnapshot": {
        "type": "object",
        "properties": {
          "orders": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Order"
            }
          },
          "lastTransactTime": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "lastTradePrice": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Price"
              },
              {
                "type": "null"
              }
            ]
          },
          "marketState": {
            "$ref": "#/components/schemas/MarketState"
          }
        },
        "required": [
          "orders",
          "lastTransactTime",
          "marketState"
        ]
      },
      "Order": {
        "description": "A resting order.",
        "type": "object",
        "properties": {
          "price": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "quantity": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "exchangeOrderId": {
            "description": "[Exchange order ID](/trade-api.md#exchange-order-id)",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "side": {
            "type": "integer",
            "format": "int32"
          },
          "priority": {
            "description": "Order priority for execution. Valid within a price level and side. That\n is, orders must first be sorted by side and price (in descending order\n for bids and ascending for asks), and then the OrderPriority within the\n level. A lower value is a higher priority.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "price",
          "quantity",
          "exchangeOrderId",
          "side",
          "priority"
        ]
      },
      "Body_for_AnyValue": {
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody_for_AnyValue"
          }
        },
        "required": [
          "error"
        ]
      },
      "ErrorBody_for_AnyValue": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "reason"
        ]
      },
      "Body_for_TradesSnapshot": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/TradesSnapshot"
          }
        },
        "required": [
          "result"
        ]
      },
      "TradesSnapshot": {
        "type": "object",
        "properties": {
          "trades": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Trade"
            }
          }
        },
        "required": [
          "trades"
        ],
        "example": {
          "trades": [
            {
              "tradeId": 2434680,
              "price": 637050,
              "aggressingSide": 1,
              "restingExchangeOrderId": 2431752357,
              "fillQuantity": 26316,
              "transactTime": 1721071666518348500,
              "aggressingExchangeOrderId": 2431752712
            }
          ]
        }
      },
      "Trade": {
        "type": "object",
        "properties": {
          "tradeId": {
            "description": "The ID assigned to this trade. All trades that occur from the same event\n will be assigned the same ID, and are considered to be an atomic batch.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "price": {
            "description": "The price that this trade occurred at.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "aggressingSide": {
            "description": "The side of the aggressing order.",
            "type": "integer",
            "format": "int32"
          },
          "restingExchangeOrderId": {
            "description": "The [Exchange order ID](/trade-api.md#exchange-order-id) of\n the resting order.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "fillQuantity": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "transactTime": {
            "description": "The [transact time](/trade-api.md#transact-time) assigned by\n the matching engine for this trade. All trades that occur from the same\n event will be assigned the same transact time.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "aggressingExchangeOrderId": {
            "description": "The [Exchange order ID](/trade-api.md#exchange-order-id) of\n the aggressing order.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "tradeId",
          "price",
          "aggressingSide",
          "restingExchangeOrderId",
          "fillQuantity",
          "transactTime",
          "aggressingExchangeOrderId"
        ]
      },
      "Body_for_TopsSnapshot": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/TopsSnapshot"
          }
        },
        "required": [
          "result"
        ]
      },
      "TopsSnapshot": {
        "type": "object",
        "properties": {
          "tops": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TopOfBook"
            }
          },
          "summaries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Summary"
            }
          }
        },
        "required": [
          "tops",
          "summaries"
        ],
        "example": {
          "tops": [
            {
              "marketId": 100022,
              "transactTime": 1721103999522960600,
              "bidPrice": 1556,
              "bidQuantity": 21427,
              "askPrice": 1571,
              "askQuantity": 19771,
              "lastPrice": 1494,
              "rolling24hPrice": 1507,
              "marketState": 1
            },
            {
              "marketId": 100030,
              "transactTime": 1721103999911184000,
              "bidPrice": 7561,
              "bidQuantity": 5622,
              "askPrice": 7870,
              "askQuantity": 3240,
              "lastPrice": 6751,
              "rolling24hPrice": 6319,
              "marketState": 1
            }
          ],
          "summaries": [
            {
              "marketId": 100022,
              "open": 1507,
              "close": 1494,
              "low": 1494,
              "high": 1507,
              "baseVolumeLo": 471,
              "baseVolumeHi": 0,
              "quoteVolumeLo": 707108,
              "quoteVolumeHi": 0
            },
            {
              "marketId": 100030,
              "open": 6319,
              "close": 6751,
              "low": 6127,
              "high": 6751,
              "baseVolumeLo": 357,
              "baseVolumeHi": 0,
              "quoteVolumeLo": 2286072,
              "quoteVolumeHi": 0
            }
          ]
        }
      },
      "TopOfBook": {
        "description": "Top of book",
        "type": "object",
        "properties": {
          "marketId": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "transactTime": {
            "description": "The [transact time](/trade-api.md#transact-time) of the latest\n book update on this market.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "bidPrice": {
            "description": "The best bid price of the direct or implied book, whichever is better.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "bidQuantity": {
            "description": "The total bid quantity at the best bid price.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "askPrice": {
            "description": "The best ask price of the direct or implied book, whichever is better.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "askQuantity": {
            "description": "The total ask quantity at the best ask price.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "lastPrice": {
            "description": "The last trade price.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "rolling24hPrice": {
            "description": "The 24h open price.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "marketState": {
            "description": "Which trading operations are currently allowed on this market.",
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "marketId",
          "transactTime",
          "marketState"
        ]
      },
      "Summary": {
        "description": "Rolling 24h stats.",
        "type": "object",
        "properties": {
          "marketId": {
            "$ref": "#/components/schemas/MarketId"
          },
          "open": {
            "description": "24h open price",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "close": {
            "description": "Latest price",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "low": {
            "description": "24h low price",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "high": {
            "description": "24h high price",
            "type": "integer",
            "format": "uint64",
            "minimum": 0,
            "nullable": true
          },
          "baseVolumeLo": {
            "description": "Low 64-bits of the base quantity traded",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "baseVolumeHi": {
            "description": "High 64-bits of the base quantity traded",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "quoteVolumeLo": {
            "description": "Low 64-bits of the quote quantity traded",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "quoteVolumeHi": {
            "description": "High 64-bits of the quote quantity traded",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        },
        "required": [
          "marketId",
          "baseVolumeLo",
          "baseVolumeHi",
          "quoteVolumeLo",
          "quoteVolumeHi"
        ]
      },
      "MarketId": {
        "type": "integer",
        "format": "uint64",
        "minimum": 0
      },
      "Body_for_Array_of_ParsedTickerResponse": {
        "type": "object",
        "properties": {
          "result": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ParsedTickerResponse"
            }
          }
        },
        "required": [
          "result"
        ]
      },
      "ParsedTickerResponse": {
        "type": "object",
        "properties": {
          "ticker_id": {
            "type": "string"
          },
          "base_currency": {
            "type": "string"
          },
          "quote_currency": {
            "type": "string"
          },
          "timestamp": {
            "description": "The millisecond timestamp of the latest update.",
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "last_price": {
            "description": "The last traded price. Also equal to the 24-hour closing price",
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "base_volume": {
            "description": "The rolling 24-hour volume in the base currency.",
            "type": "number",
            "format": "double"
          },
          "quote_volume": {
            "description": "The rolling 24-hour volume in the quote currency.",
            "type": "number",
            "format": "double"
          },
          "bid": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "ask": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "high": {
            "description": "The rolling 24-hour highest price.",
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "low": {
            "description": "The rolling 24-hour lowest price.",
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "open": {
            "description": "The rolling 24-hour opening price.",
            "type": "number",
            "format": "double",
            "nullable": true
          }
        },
        "required": [
          "ticker_id",
          "base_currency",
          "quote_currency",
          "timestamp",
          "base_volume",
          "quote_volume"
        ],
        "example": {
          "ticker_id": "SOLUSDC",
          "base_currency": "SOL",
          "quote_currency": "USDC",
          "timestamp": 1708521090000,
          "last_price": 101.17,
          "base_volume": 29332.58,
          "quote_volume": 3062431.887,
          "bid": 101.16,
          "ask": 101.17,
          "high": 109.69,
          "low": 100.23,
          "open": 107.72
        }
      },
      "Body_for_ParsedOrderBookResponse": {
        "type": "object",
        "properties": {
          "result": {
            "$ref": "#/components/schemas/ParsedOrderBookResponse"
          }
        },
        "required": [
          "result"
        ]
      },
      "ParsedOrderBookResponse": {
        "description": "A market-by-price order book.\n\n Each level contains the price and the total quantity at that price. There may be multiple\n orders at the same price.",
        "type": "object",
        "properties": {
          "ticker_id": {
            "type": "string"
          },
          "timestamp": {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          },
          "bids": {
            "description": "A list of (price, quantity) pairs, sorted by price in descending order.",
            "type": "array",
            "items": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "items": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            }
          },
          "asks": {
            "description": "A list of (price, quantity) pairs, sorted by price in ascending order.",
            "type": "array",
            "items": {
              "type": "array",
              "maxItems": 2,
              "minItems": 2,
              "items": [
                {
                  "type": "number",
                  "format": "double"
                },
                {
                  "type": "number",
                  "format": "double"
                }
              ]
            }
          }
        },
        "required": [
          "ticker_id",
          "timestamp",
          "bids",
          "asks"
